# Copiá este archivo a .env y ajustá si hace falta.
# docker compose lee este .env automáticamente para sustituir ${VAR}.

# ── Credenciales de Postgres (las usa el servicio db y arma DATABASE_URL) ──
POSTGRES_USER=iguser
POSTGRES_PASSWORD=igpass
POSTGRES_DB=igdb

# Para correr el backend con el venv local (no en Docker), apuntá a localhost:
#   DATABASE_URL=postgresql+psycopg://iguser:igpass@localhost:11/igdb
# Dentro de docker compose el backend usa el host "db" automáticamente.

# Días que vale un perfil cacheado antes de re-consultarlo a Instagram.
CACHE_TTL_DAYS=7

# Cada cuántas horas se vuelve a bajar una galería ya descargada (bulk).
GALLERY_TTL_HOURS=24

# Poné 1 para loguear cada sentencia SQL (debug).
ECHO_SQL=0

# ── pgAdmin (UI de la DB en http://localhost:8080) ──
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
