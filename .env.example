# Copiá este archivo a .env y ajustá si hace falta.
# docker compose lee este .env automáticamente para sustituir ${VAR}.

# ── Credenciales de Postgres (las usa el servicio db y arma DATABASE_URL) ──
POSTGRES_USER=iguser
POSTGRES_PASSWORD=igpass
POSTGRES_DB=igdb

# Para correr el backend con el venv local (no en Docker) no hace falta tocar nada:
#   el default de config.py ya apunta a localhost:11, que es este puerto.
# Solo si tu Postgres está en otro lado, descomentá y ajustá:  DATABASE_URL=postgresql+psycopg://user:pass@host:puerto/db

# Días que un perfil cacheado aguanta con sus contadores frescos (180 = semestral).
# SOLO los contadores: la identidad se relee del listado en cada análisis.
# Subilo = menos requests, números más viejos.
METRICS_TTL_DAYS=180

# Cada cuántas horas se vuelve a bajar una galería ya descargada (bulk).
GALLERY_TTL_HOURS=24

# Poné 1 para loguear cada sentencia SQL (debug).
ECHO_SQL=0

