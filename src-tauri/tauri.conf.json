{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "grapi",
  "version": "0.1.0",
  "identifier": "dev.grapi.desktop",
  "build": {
    "frontendDist": "../app/out",
    "beforeBuildCommand": "python ../scripts/build_sidecar.py && npm --prefix ../app run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "grapi",
        "width": 1200,
        "height": 800,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765; img-src 'self' data: blob: http://127.0.0.1:8765 https:; media-src 'self' blob: http://127.0.0.1:8765 https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/grapi-api"]
  },
  "plugins": {}
}
